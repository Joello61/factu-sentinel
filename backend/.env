# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_%kernel.environment%.db"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=8.0.32&charset=utf8mb4"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=10.11.2-MariaDB&charset=utf8mb4"
# Valeurs de développement local, alignées sur ../docker-compose.yml (utilisateur/mot de
# passe/DB "factusentinel", PostgreSQL 18). Utilisé pour les commandes bin/console lancées
# directement sur l'hôte (ex. génération de migration) ; le service "backend" du
# docker-compose surcharge cette variable avec l'hôte interne "postgres" au démarrage.
DATABASE_URL="postgresql://factusentinel:factusentinel@127.0.0.1:5432/factusentinel?serverVersion=18&charset=utf8"
###< doctrine/doctrine-bundle ###

###> symfony/mailer ###
MAILER_DSN=null://null
###< symfony/mailer ###

# Adresse d'expédition par défaut (US-AUTH-001, US-AUTH-003). Provisoire pour le
# développement : nom de domaine réel à confirmer avant mise en production.
MAILER_FROM=no-reply@factusentinel.local

###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=a6b92bbf067434b3867bdfb614234c53f41e82df6462159e5dbdccc1b3bad581
###< lexik/jwt-authentication-bundle ###

# URL publique du frontend, utilisée pour construire les liens envoyés par email
# (vérification d'email, réinitialisation de mot de passe). En dev, Nginx sert frontend
# et backend sous la même origine (docker-compose.yml, docker/nginx/default.conf).
FRONTEND_URL=http://localhost:8080

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
###< nelmio/cors-bundle ###

###> symfony/messenger ###
# Redis en local (docker-compose.yml service "redis") ; Redis n'est qu'un backend de
# transport (traitement asynchrone, Phase 7) - jamais une source de vérité métier
# (config/packages/messenger.yaml, backend/CLAUDE.md section 10).
MESSENGER_TRANSPORT_DSN=redis://127.0.0.1:6379/messages
###< symfony/messenger ###

# Phase 7 - Document Processing (docs/12-roadmap.md). Stockage local du MVP
# (backend/src/Shared/Storage/), abstrait derrière StorageInterface - jamais un chemin
# construit à partir d'une donnée utilisateur (10-security-privacy.md, section 22).
# "%kernel.project_dir%" n'est PAS résolu ici : c'est une syntaxe de paramètre du conteneur
# Symfony, jamais recursivement interprétée à l'intérieur de la valeur d'une variable
# d'environnement brute (constaté à l'implémentation - un premier essai avec ce placeholder
# créait littéralement un répertoire nommé "%kernel.project_dir%"). Chemin relatif au
# répertoire d'exécution de bin/console (backend/, en usage direct sur l'hôte) ; le service
# "backend"/"worker" du docker-compose surcharge cette variable avec le chemin absolu du
# conteneur, même principe que DATABASE_URL ci-dessus.
STORAGE_LOCAL_PATH=var/storage/documents
# 20 Mo, décision produit actée (08-api-specification.md section 31).
DOCUMENT_MAX_SIZE_BYTES=20971520
# Validator Container Mustang (ADR-008), jamais exposé publiquement - appelé uniquement
# depuis le réseau Docker interne (docker-compose.yml, service "mustang").
MUSTANG_BASE_URL=http://mustang:8080
