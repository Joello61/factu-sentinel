# Configuration Nginx de production - overlay docker-compose.prod.yml uniquement, jamais
# fusionnée avec docker/nginx/default.conf (dev/beta, tunnel Cloudflare). Templée via
# envsubst (mécanisme officiel de l'image "nginx", /etc/nginx/templates/*.template ->
# /etc/nginx/conf.d/*, vérifié sur la documentation officielle Docker Hub le 26/08/2026) -
# seule ${PUBLIC_DOMAIN} y est substituée, jamais une valeur en dur.
#
# TLS : terminé par Traefik (infrastructure de niveau serveur, hors de ce dépôt - voir le
# runbook Phase 17, section Nginx/Traefik), jamais par Nginx lui-même depuis
# l'introduction de Traefik. Nginx n'est plus l'edge public : il ne publie plus de port
# hôte (docker-compose.prod.yml) et ne sert qu'en HTTP interne sur le réseau Docker
# partagé "traefik-public" - son seul rôle restant est le pont HTTP -> FastCGI vers
# "backend" (PHP-FPM), que Traefik ne sait pas parler nativement (pas de fournisseur
# FastCGI côté Traefik).
#
# En-têtes X-Forwarded-* : posés par Traefik à l'edge, transmis ici tels quels ($http_x_
# forwarded_proto, $proxy_add_x_forwarded_for) - jamais réécrits depuis $remote_addr, qui
# ne serait plus l'IP du visiteur mais celle du conteneur Traefik.

client_max_body_size 20m;

server {
    listen 80;
    listen [::]:80;
    server_name ${PUBLIC_DOMAIN};

    # Nginx résout un nom de service Docker ("backend", "frontend") une seule fois, au
    # chargement de sa configuration, et garde l'IP en cache pour toute la durée de vie de
    # ses processus worker - un "fastcgi_pass"/"proxy_pass" statique ne se ré-résout
    # JAMAIS ensuite. Or "backend" change d'IP à chaque redéploiement (nouveau conteneur) -
    # constaté en usage réel : le premier redéploiement de production après la mise en
    # place de Traefik a cassé Nginx en silence ("502 Bad Gateway"), Nginx continuant de
    # cibler l'ancienne IP du conteneur "backend" remplacé, jusqu'à un rechargement manuel
    # ("nginx -s reload"). "resolver" (DNS interne Docker, présent sur tout réseau
    # utilisateur) + une variable dans "fastcgi_pass"/"proxy_pass" forcent une résolution
    # dynamique à chaque expiration du TTL, plutôt qu'une résolution figée au démarrage
    # (mécanisme documenté officiellement par Nginx pour ce cas précis).
    resolver 127.0.0.11 valid=10s;

    location /api/ {
        set $backend_upstream backend:9000;
        fastcgi_pass $backend_upstream;
        fastcgi_index index.php;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME /app/public/index.php;
        fastcgi_param DOCUMENT_ROOT /app/public;
        fastcgi_param HTTP_X_FORWARDED_FOR $proxy_add_x_forwarded_for;
        fastcgi_param HTTP_X_FORWARDED_PROTO $http_x_forwarded_proto;
    }

    location / {
        set $frontend_upstream http://frontend:3000;
        proxy_pass $frontend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    }
}
