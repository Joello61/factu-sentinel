{
  "title": "FactuSentinel - API et Compliance Engine",
  "uid": "factusentinel-api-compliance",
  "tags": ["factusentinel", "phase-18"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Débit HTTP par classe de réponse (req/s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum(rate(factusentinel_http_2xx_responses_total[5m]))", "legendFormat": "2xx" },
        { "refId": "B", "expr": "sum(rate(factusentinel_http_4xx_responses_total[5m]))", "legendFormat": "4xx" },
        { "refId": "C", "expr": "sum(rate(factusentinel_http_5xx_responses_total[5m]))", "legendFormat": "5xx" }
      ]
    },
    {
      "id": 2,
      "title": "Latence des requêtes (p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(factusentinel_request_durations_histogram_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95 toutes routes"
        }
      ]
    },
    {
      "id": 3,
      "title": "Analyses de conformité déclenchées, par résultat",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(factusentinel_compliance_analyses_total[15m])) by (result)",
          "legendFormat": "{{result}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Durée d'une analyse de conformité (p95, par résultat)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(factusentinel_compliance_analysis_duration_seconds_bucket[15m])) by (le, result))",
          "legendFormat": "{{result}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Imports de documents, par issue",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(factusentinel_document_uploads_total[15m])) by (outcome)",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "Appels Mistral (AI Gateway), par issue",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(factusentinel_ai_calls_total[15m])) by (outcome)",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 7,
      "title": "Appels Mustang, par opération et issue",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(factusentinel_mustang_calls_total[15m])) by (operation, outcome)",
          "legendFormat": "{{operation}} - {{outcome}}"
        }
      ]
    },
    {
      "id": 8,
      "title": "Coût IA estimé (24h glissantes)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "currencyEUR" }, "overrides": [] },
      "targets": [{ "refId": "A", "expr": "factusentinel_ai_estimated_cost_24h_eur" }]
    },
    {
      "id": 9,
      "title": "Taux d'échec Compliance Engine (24h)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "targets": [{ "refId": "A", "expr": "factusentinel_compliance_engine_failure_rate_24h" }]
    },
    {
      "id": 10,
      "title": "Jobs en échec définitif (dead-letter)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "factusentinel_async_jobs_dead_letter_count" }]
    },
    {
      "id": 11,
      "title": "Connectivité Redis / Mustang",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "Injoignable", "color": "red" }, "1": { "text": "OK", "color": "green" } } }
          ]
        },
        "overrides": []
      },
      "targets": [
        { "refId": "A", "expr": "factusentinel_redis_reachable", "legendFormat": "Redis" },
        { "refId": "B", "expr": "factusentinel_mustang_reachable", "legendFormat": "Mustang" }
      ]
    }
  ]
}
