{
  "title": "FactuSentinel - Logs",
  "uid": "factusentinel-logs",
  "tags": ["factusentinel", "phase-18"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "service_name",
        "type": "query",
        "datasource": { "type": "loki", "uid": "loki" },
        "query": "label_values(service_name)",
        "refresh": 2,
        "includeAll": true,
        "multi": true
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Erreurs (level=error), tous services",
      "type": "logs",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": { "showTime": true, "wrapLogMessages": true },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=~\"$service_name\"} | json | level=\"ERROR\""
        }
      ]
    },
    {
      "id": 2,
      "title": "Rafale de 5xx (dérivé des logs backend/nginx)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 10 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({service_name=~\"$service_name\"} | json | level=\"ERROR\" [5m]))",
          "legendFormat": "Erreurs / 5min"
        }
      ]
    },
    {
      "id": 3,
      "title": "Tous les logs (bruts, filtrable par requête)",
      "type": "logs",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 18 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": { "showTime": true, "wrapLogMessages": true },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=~\"$service_name\"}"
        }
      ]
    }
  ]
}
