# Exemple de fichier d'environnement de production/staging (Phase 17, docs/12-roadmap.md).
# Copier en .env.staging OU .env.production (jamais commités, voir .gitignore) et renseigner
# les valeurs réelles - deux fichiers distincts, deux jeux de valeurs distincts, jamais
# partagés entre les deux environnements (10-security-privacy.md section 53).
#
# Usage :
#   docker compose --env-file .env.staging    -f docker-compose.yml -f docker-compose.prod.yml up -d
#   docker compose --env-file .env.production -f docker-compose.yml -f docker-compose.prod.yml up -d

# Nom de domaine public de cet environnement (ex. staging.factusentinel.fr ou
# app.factusentinel.fr) - jamais le même pour staging et production. Utilisé à la fois
# par Nginx (server_name) et par la règle Host() du label Traefik (docker-compose.prod.yml,
# service "nginx") - le certificat TLS et son renouvellement sont gérés par Traefik
# (infrastructure de niveau serveur, hors de ce dépôt, voir docker/nginx/README.md et le
# runbook serveur Phase 17), jamais par ce dépôt lui-même depuis l'introduction de
# Traefik - pas de variable ACME_EMAIL ici, elle vit dans la stack Traefik partagée.
PUBLIC_DOMAIN=exemple.factusentinel.fr

# Images GHCR taguées par SHA de commit, publiées par .github/workflows/deploy.yml - jamais
# un tag flottant ("latest") en production (l'image déployée doit être exactement celle
# qui a passé les Release Gates, voir plan Phase 17 section 5).
BACKEND_IMAGE=ghcr.io/joello61/factu-sentinel-backend:REMPLACER_PAR_LE_SHA
FRONTEND_IMAGE=ghcr.io/joello61/factu-sentinel-frontend:REMPLACER_PAR_LE_SHA
MUSTANG_IMAGE=ghcr.io/joello61/factu-sentinel-mustang:REMPLACER_PAR_LE_SHA

# Regex d'origine pour nelmio/cors-bundle (CORS_ALLOW_ORIGIN, origin_regex: true) - doit
# correspondre exactement à PUBLIC_DOMAIN ci-dessus, jamais un wildcard.
CORS_ALLOW_ORIGIN=^https://exemple\.factusentinel\.fr$
FRONTEND_URL=https://exemple.factusentinel.fr

# "false" tant que le certificat réel n'est pas confirmé actif (docker/nginx/README.md) -
# jamais "true" par anticipation, au risque de rendre le site inaccessible.
HSTS_ENABLED=false

# Identifiants PostgreSQL réels de cet environnement - jamais les valeurs de dev
# (factusentinel/factusentinel), jamais réutilisés entre staging et production. Générer
# avec "openssl rand -hex 32" - jamais "base64" (peut produire "/", "+", "=", invalides
# une fois interpolés tels quels dans DATABASE_URL, docker-compose.yml : constaté au
# premier déploiement réel, "Malformed parameter \"url\"").
POSTGRES_USER=REMPLACER
POSTGRES_PASSWORD=REMPLACER
POSTGRES_DB=REMPLACER

# Port hôte de l'interface Uptime Kuma (docker-compose.prod.yml, service "monitoring"),
# lié à 127.0.0.1 uniquement (accès par tunnel SSH, docker/monitoring/README.md) - doit
# être UNIQUE sur tout le VPS, jamais le même que celui d'un autre environnement/projet
# hébergé sur ce serveur (constaté au premier déploiement production réel : "Bind for
# 127.0.0.1:3001 failed: port is already allocated", staging l'utilisait déjà). Exemple :
# 3001 pour production, 3002 pour staging.
MONITORING_PORT=REMPLACER

# Nom de projet Compose de CET environnement - doit être unique sur tout le VPS (ex.
# "factusentinel-production" / "factusentinel-staging"), jamais la même valeur pour les
# deux. Consommé par Docker Compose lui-même (résout les noms de conteneurs/volumes/réseaux
# par défaut) ET par Alloy (docker/observability/alloy-config.alloy) pour ne remonter que
# les logs des conteneurs de CET environnement, jamais ceux de l'autre stack partageant le
# même socket Docker (Phase 18, portée "production uniquement").
COMPOSE_PROJECT_NAME=REMPLACER

# Active la stack d'observabilité (Loki, Alloy, Prometheus, Grafana, Tempo - Phase 18,
# docs/19-observability-architecture.md) - à ne définir QUE dans .env.production, jamais
# dans .env.staging (portée décidée pour cette phase : apprentissage, pas un besoin de
# staging). Mécanisme Docker Compose standard ("profiles") : ces services ne démarrent
# jamais sans cette variable, quel que soit l'environnement.
COMPOSE_PROFILES=observability
