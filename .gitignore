# .gitignore global - FactuSentinel
#
# Ce fichier couvre uniquement ce qui n'est pas déjà couvert par les .gitignore
# spécifiques de backend/ (Symfony/PHP) et frontend/ (Next.js/TypeScript).

# OS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini

# Éditeurs / IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Variables d'environnement et secrets - UNIQUEMENT à la racine du dépôt (le "/" ancre
# le motif ici ; sans lui, ".env" s'appliquerait aussi à backend/.env, qui doit au
# contraire être committé par convention Symfony - seul backend/.env.local est un secret).
/.env
/.env.local
/.env.*.local

# Valeurs réelles de la session Private Beta en cours (Phase 12, docs/14-private-beta-plan.md) -
# URL de tunnel et origine CORS de la session, jamais figées ni commitées ; seul
# .env.beta.example (placeholders) est versionné.
/.env.beta

# Valeurs réelles de staging/production (Phase 17, docs/12-roadmap.md) - domaine, images
# GHCR, secrets PostgreSQL ; seul .env.prod.example (placeholders) est versionné.
/.env.staging
/.env.production

# Labels Traefik réels (nom de routeur par environnement, Phase 17, runbook serveur) -
# propre à chaque environnement/serveur, jamais partagé ; seul
# docker-compose.prod.traefik.yml.example est versionné.
/docker-compose.prod.traefik.yml

# Docker (volumes/données locales, overrides personnels)
docker-compose.override.yml
docker/**/data/
docker/**/*.local.yml
# Phase 18 - jeton de scrape Prometheus, créé une fois manuellement sur le serveur
# (docker/observability/README.md), jamais committé (../CLAUDE.md section 15).
docker/observability/secrets/

# Infrastructure (état/config locale, jamais de secret commité)
infra/**/*.local.*
infra/**/secrets/

# Logs
*.log
logs/

# Archives temporaires
*.tmp
*.bak

# Sauvegardes locales (docker/backup/, Phase 10) - jamais une sauvegarde réelle committée,
# même chiffrée.
/backups/
