# Exemple de fichier .env.beta pour la Private Beta (Phase 12, docs/14-private-beta-plan.md).
# Copier en .env.beta (jamais commité, /.env.beta dans .gitignore) et renseigner les valeurs
# réelles de la session en cours. Un Cloudflare Quick Tunnel génère un sous-domaine
# trycloudflare.com ALEATOIRE à chaque lancement - ces valeurs doivent donc être régénérées
# avant chaque session supervisée, pas figées une fois pour toutes.
#
# Usage :
#   docker compose --env-file .env.beta -f docker-compose.yml -f docker-compose.beta.yml up -d

# URL https publique complète du tunnel de la session en cours (sans slash final), affichée
# par cloudflared au démarrage - voir `docker compose logs cloudflared`.
BETA_PUBLIC_URL=https://exemple-aleatoire.trycloudflare.com

# Regex d'origine correspondante pour nelmio/cors-bundle (CORS_ALLOW_ORIGIN, origin_regex: true) -
# doit correspondre exactement au host ci-dessus.
BETA_PUBLIC_ORIGIN_REGEX=^https://exemple-aleatoire\.trycloudflare\.com$
